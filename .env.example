# ── LLM Provider ──────────────────────────────────────────────────────────────
# Seçenekler: anthropic | nvidia | groq | together | deepseek | mistral | openai
LLM_PROVIDER=anthropic

# Hangi provider'ı kullanıyorsanız o API key'ini doldurun.
# LLM_API_KEY — evrensel; yoksa NVIDIA_API_KEY, GROQ_API_KEY, vb. de okunur.
LLM_API_KEY=

# Model override — boş bırakırsanız provider default'u kullanılır.
LLM_MODEL=

# Özel endpoint (vLLM, Ollama, LM Studio için)
LLM_BASE_URL=

# Claude extended thinking — sadece claude-3-7+ modelleri, "1" ile etkinleştirin
LLM_THINKING=0

# ── Provider bazlı örnekler ───────────────────────────────────────────────────
# NVIDIA NIM (ücretsiz tier):
#   LLM_PROVIDER=nvidia
#   LLM_API_KEY=nvapi-...            # integrate.api.nvidia.com'dan alın
#   LLM_MODEL=meta/llama-3.1-70b-instruct
#   Diğer modeller: mistralai/mistral-7b-instruct-v0.3
#                   microsoft/phi-3-medium-128k-instruct
#                   nvidia/nemotron-4-340b-instruct

# Groq (çok hızlı, ücretsiz tier):
#   LLM_PROVIDER=groq
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=llama-3.1-70b-versatile

# DeepSeek R1 (reasoning/thinking):
#   LLM_PROVIDER=deepseek
#   LLM_API_KEY=sk-...
#   LLM_MODEL=deepseek-reasoner

# Together AI:
#   LLM_PROVIDER=together
#   LLM_API_KEY=...
#   LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# Yerel vLLM / Ollama:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://localhost:8000/v1    # veya http://localhost:11434/v1
#   LLM_API_KEY=dummy
#   LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# Anthropic (varsayılan):
ANTHROPIC_API_KEY=sk-ant-...

# ── Embedding & Reranking ─────────────────────────────────────────────────────
# Voyage AI — https://dash.voyageai.com
VOYAGE_API_KEY=pa-...

# Cohere — https://dashboard.cohere.com
COHERE_API_KEY=...

# ── Qdrant Cloud — https://cloud.qdrant.io ────────────────────────────────────
QDRANT_URL=https://xyz.us-east-1.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=...
